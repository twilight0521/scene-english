PORT=3001
# Generate your own long password. Admin features are disabled without it.
ADMIN_PASSWORD=
# Optional OpenAI-compatible transcription endpoint; keys stay on server.
ASR_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
# Set when serving HTTPS in production.
COOKIE_SECURE=false
DATA_DIR=./data
ASR_RESPONSE_FORMAT=verbose_json
TRUST_PROXY=false
